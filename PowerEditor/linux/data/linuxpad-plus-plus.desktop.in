[Desktop Entry]
Type=Application
Name=LinuxPad++
GenericName=Text Editor
Comment=Source code editor, the native Linux edition of Notepad++
Exec=@NPP_INSTALL_BINARY@ %F
Icon=@NPP_INSTALL_ICON@
Terminal=false
StartupNotify=true
StartupWMClass=linuxpad++
Categories=Utility;TextEditor;
Keywords=text;editor;code;notepad;notepad++;
MimeType=text/plain;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-java;text/x-python;text/x-shellscript;text/x-makefile;text/x-cmake;text/x-sql;text/x-lua;text/x-perl;text/x-php;text/x-ruby;text/x-go;text/rust;text/markdown;text/html;text/css;text/xml;application/xml;application/json;application/x-yaml;text/x-ini;application/javascript;application/x-shellscript;
