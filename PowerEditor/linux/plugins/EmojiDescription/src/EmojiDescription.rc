#include <windows.h>
#include "UnicodeNames.h"
#include "CharDetailsDialog.h"

// Embedded Unicode character-name table (generated by
// tools/unicode_names/gen_names.py). Consumed at runtime by UnicodeNames.cpp.
IDR_UNICODE_NAMES RCDATA "UnicodeNames.bin"

// "Copy character details..." dialog. Both edit fields are read-only: selecting
// with the mouse and copying with Ctrl+C still work, but the values cannot be
// edited into something that was never true and then copied out.
IDD_CHAR_DETAILS DIALOGEX 0, 0, 286, 170
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Character Details"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_CHAR_GLYPH, 7, 7, 44, 34, ES_CENTER | ES_READONLY | ES_AUTOHSCROLL
    EDITTEXT        IDC_CHAR_INFO, 7, 47, 272, 96, ES_MULTILINE | ES_READONLY | WS_VSCROLL
    DEFPUSHBUTTON   "&Copy to clipboard", IDC_CHAR_COPY, 155, 149, 76, 14
    PUSHBUTTON      "Close", IDCANCEL, 235, 149, 44, 14
END

#define VERSION_VALUE "0.4.17\0"
#define VERSION_DIGITALVALUE 0, 4, 17, 0

VS_VERSION_INFO VERSIONINFO
FILEVERSION	VERSION_DIGITALVALUE
PRODUCTVERSION	VERSION_DIGITALVALUE
FILEFLAGSMASK	0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK	"VarFileInfo"
	BEGIN
		VALUE	"Translation",	0x409,	1200
	END
	BLOCK	"StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE	"CompanyName",	"Ruberoid\0"
			VALUE	"FileDescription",	"Displays detailed character encoding information in the status bar\0"
			VALUE	"FileVersion",	VERSION_VALUE
			VALUE	"InternalName",	"EmojiDescription.dll\0"
			VALUE	"LegalCopyright",	"Copyright 2026 by Ruberoid\0"
			VALUE	"OriginalFilename",	"EmojiDescription.dll\0"
			VALUE	"ProductName",	"Emoji Description\0"
			VALUE	"ProductVersion",	VERSION_VALUE
		END
	END
END
